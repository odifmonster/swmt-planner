from dataclasses import dataclass
from datetime import datetime, timedelta
from typing import Literal

from swmtplanner.products import Greige
from swmtplanner.schedule import Machine, ProductionPlan, Inventory
from swmtplanner.demand.rlsitem import RlsItem

__all__ = ['Move', 'State', 'PriorCommit']


@dataclass
class Move:
    machine_id: str
    item: Greige
    lbs: float
    start_at: Literal['schedule_tail', 'next_runout']
    idle_for: timedelta
    plan: ProductionPlan
    week_idx: int | None = ...
    order_remaining_lbs: float = ...


@dataclass
class PriorCommit:
    """A prior-plan job and its fate in this run (open / consumed / dropped)."""
    machine: str
    prior_job: str
    item: str
    rolls: int
    order: str | None
    due_date: datetime | None
    start: datetime
    status: Literal['open', 'consumed', 'dropped'] = ...
    job_id: str | None = ...
    note: str = ...


@dataclass
class State:
    machines: dict[str, Machine]
    rls_items: dict[str, RlsItem]
    start_date: datetime
    window_end: datetime
    inventory: Inventory = ...
    """Beam-set stock keyed by physical description; read by candidate plans,
    mutated only by `commit_move`."""
    window_advance_amount: timedelta = ...
    carrying_avoidance_margin: timedelta = ...
    candidate_threshold: int = ...
    planning_horizon_buffer: timedelta = ...
    reference_week_idx: int = ...
    reference_advance_amount: int = ...
    reference_threshold: int = ...
    eoq_threshold_rolls: int = ...
    """A unique-setup regular move sized at or under this many rolls is batched (3)."""
    eoq_batch_rolls: int = ...
    """…up to this many rolls of the item's later demand (4)."""
    prior: dict[str, list[PriorCommit]] = ...
    """The prior plan's jobs, per machine in start order, each with its fate."""
    frozen_window: timedelta | None = ...
    """Only prior jobs starting before `start_date + frozen_window` are
    recommitted; None (the default) is unbounded."""
    def commit_move(self, move: Move) -> None: ...
    def advance_window(self) -> None: ...
    def advance_reference_week(self) -> None: ...
